<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 较小的圆角，避免变成胶囊形 -->
    <corners android:radius="6dp" />
    <!-- 极细的浅色边框，降低视觉存在感 -->
    <stroke
        android:width="1dp"
        android:color="#000000" />
    <solid android:color="#00000000" />
</shape>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Main shell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Flat page content, no top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- HOME（首屏，始终随主布局 inflate） -->
            <include layout="@layout/page_home" />

            <!-- APPS（懒加载：首次点“应用”页时 inflate page_apps.xml） -->
            <ViewStub
                android:id="@+id/pageAppsStub"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_apps"
                android:inflatedId="@+id/pageApps" />

            <!-- SETTINGS (懒加载：首次点“设置”页时 inflate page_settings.xml) -->
            <ViewStub
                android:id="@+id/pageSettingsStub"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/page_settings"
                android:inflatedId="@+id/pageSettings" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <!-- Bottom navigation: one line, three words, one lock -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <TextView
                android:id="@+id/infoTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="00:00"
                android:textColor="@color/gray"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:id="@+id/tabHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/tab_home"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/dotHome"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:id="@+id/tabAppsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/tab_apps"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/dotApps"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/ink"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:id="@+id/tabSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/tab_settings"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/dotSettings"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/ink"
                    android:visibility="invisible" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnLock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/lock"
                android:src="@drawable/ic_lock" />
        </LinearLayout>

        <!-- Batch management action bar (replaces bottom bar in manage mode) -->
        <LinearLayout
            android:id="@+id/manageBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/manageHide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/manage_hide"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/manageShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:fontFamily="serif"
                android:text="@string/manage_show"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/manageUninstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:fontFamily="serif"
                android:text="@string/manage_uninstall"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/manageDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/manage_done"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom action sheet (no system dialog) -->
    <FrameLayout
        android:id="@+id/actionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/actionDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/paper"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/actionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:fontFamily="serif"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/actionPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/actionHide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/actionAppInfo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/actionClose"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/action_close"
                android:textColor="@color/gray"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Recent tasks overlay (double-click home tab) -->
    <FrameLayout
        android:id="@+id/recentOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/recentDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/recentPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/paper"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="@string/recent_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/recentClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_clear"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/recentMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:fontFamily="serif"
                android:textColor="@color/gray"
                android:textSize="16sp"
                android:visibility="gone" />

            <com.yota.launcher.ui.EInkLauncherView
                android:id="@+id/recentGrid"
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/recentCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/recent_cancel"
                android:textColor="@color/gray"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Selection popup (settings multi-option rows) -->
    <FrameLayout
        android:id="@+id/selectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/selectDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/selectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/paper"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/selectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:fontFamily="serif"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:id="@+id/selectList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/selectCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/recent_cancel"
                android:textColor="@color/gray"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Usage help / about overlay -->
    <FrameLayout
        android:id="@+id/infoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <TextView
                    android:id="@+id/infoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/infoClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_close"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/infoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:autoLink="email"
                        android:fontFamily="serif"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="24dp"
                        android:layout_marginRight="24dp"
                        android:background="@color/hairline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/donation_title"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/donation_text"
                        android:textColor="@color/gray"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/donationQr"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/donation_text"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:id="@+id/rowDonationPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginLeft="24dp"
                        android:layout_marginRight="24dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="@string/settings_donation_prompt"
                            android:textColor="@color/ink"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/settingsDonationPromptValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/gray"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- WiFi book transfer overlay (click the clock on home) -->
    <FrameLayout
        android:id="@+id/wifiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <TextView
                    android:id="@+id/wifiTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="@string/wifi_transfer_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/wifiClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_transfer_close"
                    android:textColor="@color/gray"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/wifiQr"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/wifi_transfer_title"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/wifiUrlText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wifiHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/gray"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Donation prompt overlay (after 50 HOME presses) -->
    <FrameLayout
        android:id="@+id/donationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:paddingTop="52dp"
                android:paddingRight="24dp"
                android:paddingBottom="16dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/donation_prompt_title"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <ImageView
                android:id="@+id/donationPromptQr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/donation_text"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/donation_text"
                android:textColor="@color/gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/donationHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/donation_prompt_hint"
                android:textColor="@color/gray"
                android:textSize="11sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/donationClose"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:fontFamily="serif"
                android:text="@string/donation_close_wait"
                android:textColor="@color/gray"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- First-use guide overlay -->
    <FrameLayout
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:paddingTop="52dp"
                android:paddingRight="24dp"
                android:paddingBottom="16dp"
                android:fontFamily="serif"
                android:text="@string/guide_title"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="24dp"
                        android:paddingTop="20dp"
                        android:paddingRight="24dp"
                        android:paddingBottom="20dp"
                        android:fontFamily="serif"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/guide_body"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="24dp"
                        android:layout_marginRight="24dp"
                        android:background="@color/hairline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/donation_title"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/donation_text"
                        android:textColor="@color/gray"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/guideDonationQr"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/donation_text"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/guideStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:fontFamily="serif"
                android:text="@string/guide_start"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
